const installButton = document.getElementById('installBtn');

let deferredPrompt = null;

window.addEventListener('beforeinstallprompt', (event) => {
  event.preventDefault();
  deferredPrompt = event;
  installButton.style.display = 'inline-flex';
});

installButton?.addEventListener('click', async () => {
  if (!deferredPrompt) {
    installButton.textContent = 'التطبيق مثبت بالفعل';
    return;
  }

  deferredPrompt.prompt();
  await deferredPrompt.userChoice;
  deferredPrompt = null;
  installButton.style.display = 'none';
});

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js').catch((error) => {
      console.error('Service worker registration failed:', error);
    });
  });
}

const currentDate = new Date();
const currentMonth = currentDate.toLocaleDateString('ar-SA', { month: 'long' });
const summaryText = `تحديث الشبكة: ${currentMonth} ${currentDate.getFullYear()}`;

document.title = `MikroTik AI Manager | ${summaryText}`;
